{
  "name": "aernova",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && next build",
    "db:start": "pg_ctl -D .postgres-data status || LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 pg_ctl -D .postgres-data -o \"-p 5433\" -l .postgres-data/server.log start",
    "db:status": "pg_ctl -D .postgres-data status",
    "db:stop": "pg_ctl -D .postgres-data stop",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:backfill-money": "node --env-file=.env --experimental-strip-types prisma/backfill-money.ts",
    "db:backfill-domain": "node --env-file=.env --experimental-strip-types prisma/backfill-domain.ts",
    "db:seed-catalog": "node --env-file=.env --experimental-strip-types prisma/seed-catalog.ts",
    "db:seed-warranty-templates": "node --env-file=.env --experimental-strip-types prisma/seed-warranty-templates.ts",
    "db:seed-workflow-templates": "node --env-file=.env --experimental-strip-types prisma/seed-workflow-templates.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "import:photos": "node --env-file=.env --experimental-strip-types prisma/import-photos.ts",
    "nodeodm": "scripts/nodeodm.sh",
    "test:visual:seed": "node --env-file=.env --experimental-strip-types tests/visual/fixtures/seed-visual-test-company.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@astryxdesign/core": "0.3.0",
    "@aws-sdk/client-s3": "^3.1073.0",
    "@clerk/nextjs": "^7.2.3",
    "@google/genai": "2.17.1",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.65.0",
    "@stylexjs/stylex": "0.19.0",
    "@types/three": "^0.184.1",
    "animejs": "4.5.0",
    "fflate": "^0.8.3",
    "lucide-react": "1.31.0",
    "motion": "13.1.0",
    "next": "16.2.4",
    "openai": "^6.35.0",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "stripe": "^22.4.0",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.10"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.3.0",
    "@clerk/testing": "2.2.24",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "@astryxdesign/cli@0.3.0": true,
    "@astryxdesign/core@0.3.0": true
  }
}
