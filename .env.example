# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# --- Site identity -----------------------------------------------------------
# The app's own public URL — used for Open Graph/Twitter card metadata and
# robots.txt/sitemap.xml, which are generated at build time with no request
# to read a host header from (unlike lib/share-token.ts's shareUrl, which
# derives its origin per-request). Fine to leave unset for local dev; defaults
# to the production domain.
# NEXT_PUBLIC_APP_URL=https://app.aernova.ca

# --- Database --------------------------------------------------------------
# Local dev uses the bundled Postgres on port 5433 (see npm run db:start).
DATABASE_URL="postgresql://USER@localhost:5433/aernova"

# --- Auth (Clerk) ----------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Use the app's own branded pages instead of Clerk's hosted portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- AI (Anthropic / Claude) ----------------------------------------------
# Powers the per-project roof assistant (and features 19-23). Without it the
# chat endpoint returns 503 "AI is not configured".
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Error monitoring (Sentry) ---------------------------------------------
# Errors-only, production-only. Without a DSN Sentry is disabled entirely, so
# the app builds and runs unchanged. Create a project at sentry.io to get one.
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx
# Optional: label the deploy (defaults to NODE_ENV).
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Optional: set ALL THREE to upload source maps at build time, so stack traces
# show your real code instead of minified bundles. Omit and the build skips upload.
# SENTRY_ORG=your-org
# SENTRY_PROJECT=aernova
# SENTRY_AUTH_TOKEN=sntrys_xxx

# --- Email (Resend) ---------------------------------------------------------
# Sends a quote by email instead of only handing over a link to paste into a
# text. Without RESEND_API_KEY, email is disabled entirely and the quote panel
# only offers the link — same as it does today. Get a key at resend.com and
# verify a sending domain there first; RESEND_FROM_EMAIL must be an address on
# that verified domain, not a placeholder.
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=quotes@yourcompany.com

# --- Payments (Stripe) ------------------------------------------------------
# Phase 5b: connecting a company's own Stripe Express account so it can accept
# card payments on its invoices. Without STRIPE_SECRET_KEY, the /settings
# payments page and the public invoice's Pay button are both disabled —
# nothing else in the app depends on this. Test-mode keys need no business
# verification: dashboard.stripe.com/register, then Connect -> Get started ->
# Express, then Developers -> API keys (with "Test mode" on).
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Only needed to verify webhook deliveries — printed by `stripe listen
# --forward-to localhost:3000/api/webhooks/stripe` while testing locally.
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- File storage ----------------------------------------------------------
# STORAGE_DRIVER=local (default) writes to public/uploads — fine for local dev
# and single-server deploys. For cloud/object storage set STORAGE_DRIVER=s3
# (works with AWS S3 or Cloudflare R2) plus the values below.
# STORAGE_DRIVER=local
# S3_BUCKET=aernova-uploads
# S3_REGION=auto                # "auto" for Cloudflare R2; e.g. us-east-1 for AWS
# S3_ENDPOINT=                  # R2: https://<account>.r2.cloudflarestorage.com; leave blank for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_BASE_URL=      # public/CDN base that serves the bucket, e.g. https://cdn.example.com

# --- Photogrammetry worker (NodeODM) --------------------------------------
# Without NODEODM_URL the app uses the built-in draft model package.
NODEODM_URL=
NODEODM_TOKEN=
# NODEODM_OPTIONS_JSON='[{"name":"dsm","value":true},{"name":"gltf","value":true}]'

# --- Scheduled jobs (cron) --------------------------------------------------
# Gates /api/cron/invoice-reminders, /api/cron/quote-reminders, and
# /api/cron/sync-processing. Without it, those routes are wide open — anyone
# who finds the URL can trigger a reminder-email sweep or a processing sync.
# Fine to leave unset for local dev; MUST be set before any public deploy.
# Vercel Cron sends this automatically as `Authorization: Bearer <value>`
# once you set the same value as an env var on the project — see vercel.json
# for the schedules. Generate one with: openssl rand -hex 32
# CRON_SECRET=
